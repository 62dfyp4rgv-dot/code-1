    {"id":"cost_of_living_protests","title":"Cost-of-living protests in {country}","text":"Rising prices have brought crowds into the streets of {country}. Unions and opposition parties demand action from {leader}.","when":[["econ.infl",">",0.075],["gov.approval","<",0.5]],"mtth":4,"cooldown":18,"severe":true,
